datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator db {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

//Emun de Estados para entidades
enum Status {
    enable
    disable
    deleted
}

// Enum de Roles de Usuario
enum Role {
    ADMIN
    TEACHER
    STUDENT
}

// Enum de Estados de progreso de curso
enum ProgressStatus {
    uninitiated
    initialized
    completed
}

// Modelo de Usuarios
model User {
    id          String      @id @default(uuid())
    name        String
    email       String      @unique
    role        Role        @default(STUDENT)
    status      Status      @default(enable)
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @default(now())
    progress    UserCourseProgress[]
}

// Modelo de Cursos
model Course {
    id          String      @id @default(uuid())
    name        String
    description String?
    status      Status      @default(enable)
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    projects    Projects[]
    progress    UserCourseProgress[]
}

// Modelo de Proyectos/ Laboratorios
model Projects {
    id          String      @id @default(uuid())
    name        String
    description String?
    status      Status      @default(enable)
    courseId    String
    course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt
}

// Modelo de Progreso de Usuario por Curso
model UserCourseProgress {
    id              String          @id @default(uuid())
    userId          String
    courseId        String
    status          ProgressStatus  @default(uninitiated)
    hoursdedicated  Float           @default(0.0)
    percentage      Float           @default(0.0)
    updatedAt       DateTime        @updatedAt

    user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    course          Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
    @@unique([userId, courseId])
}
